BOOTPAY_TEST_COMMERCE_S_AT=2024-01-01
BOOTPAY_TEST_COMMERCE_E_AT=2099-12-31

# Commerce role default (user/manager/supervisor/vendor/partner)
# orderCancel.*, orderSubscriptionAdjustment.*, orderSubscription.update 류는 manager+ 필요.
BOOTPAY_TEST_COMMERCE_ROLE=user
